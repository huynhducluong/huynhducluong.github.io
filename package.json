{
  "name": "huynhducluong.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "setup:admin-password": "node scripts/set-admin-password.mjs",
    "dev": "vite",
    "check": "tsc --noEmit",
