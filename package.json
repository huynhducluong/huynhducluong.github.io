    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "supabase": "^2.119.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "cropperjs": "^2.2.0"
  }
