  "<section class="portfolio-page portfolio-page--project portfolio-page--project-classic" data-portfolio-layout="project.classic"><header class="portfolio-page-header"><strong>HUỲNH ĐỨC LƯƠNG</strong><span>Dự án tiêu biểu</span></header><div class="portfolio-project portfolio-project--classic"><div class="portfolio-project__visual" data-pf-bleed><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="portrait"><span>Vị trí hình ảnh dự án</span></div></div><div class="portfolio-project__content"><div class="portfolio-project-heading"><p class="portfolio-kicker">01 / Cà Mau</p><h2>Đường giao thông ra đảo Hòn Khoai</h2><strong>Điều phối viên BIM</strong></div><p class="portfolio-project__summary">Dự án gồm cây cầu vượt biển dài nhất Việt Nam, dài hơn 18 km với tổng mức đầu tư hơn 25,7 nghìn tỷ đồng, kết nối khu vực Đất Mũi với cảng lưỡng dụng Hòn Khoai tại Cà Mau.</p><ul class="portfolio-responsibilities"><li>Dẫn dắt đội ngũ mô hình BIM và phối hợp mô hình đa bộ môn.</li><li>Kiểm tra chất lượng mô hình và xử lý các vấn đề phối hợp, xung đột.</li><li>Quản lý mô hình BIM và hồ sơ bàn giao qua Autodesk Construction Cloud.</li><li>Phát triển công cụ Revit và Civil 3D bằng C#, WPF, Dynamo và Python để nâng cao hiệu quả dựng mô hình.</li></ul><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></div></div><footer class="portfolio-page-footer"><span>BIM · Hạ tầng · Tự động hóa</span><strong>04 / 07</strong></footer></section>",
  "<section class="portfolio-page portfolio-page--project portfolio-page--project-classic" data-portfolio-layout="project.classic"><header class="portfolio-page-header"><strong>HUỲNH ĐỨC LƯƠNG</strong><span>Dự án tiêu biểu</span></header><div class="portfolio-project portfolio-project--classic"><div class="portfolio-project__visual" data-pf-bleed><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="portrait"><span>Vị trí hình ảnh dự án</span></div></div><div class="portfolio-project__content"><div class="portfolio-project-heading"><p class="portfolio-kicker">02 / Cà Mau</p><h2>Cao tốc Cà Mau - Cái Nước</h2><strong>Điều phối viên BIM</strong></div><p class="portfolio-project__summary">Dự án cao tốc Cà Mau - Cái Nước dài 42 km, gồm 37 cây cầu và là đoạn quan trọng của tuyến cao tốc hướng về Đất Mũi, tăng cường kết nối và hỗ trợ phát triển kinh tế Đồng bằng sông Cửu Long.</p><ul class="portfolio-responsibilities"><li>Dẫn dắt đội ngũ mô hình BIM và phối hợp mô hình đa bộ môn.</li><li>Kiểm tra chất lượng mô hình và xử lý các vấn đề phối hợp, xung đột.</li><li>Quản lý mô hình BIM và hồ sơ bàn giao qua Autodesk Construction Cloud.</li><li>Phát triển công cụ Revit và Civil 3D bằng C#, WPF, Dynamo và Python để nâng cao hiệu quả dựng mô hình.</li></ul><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></div></div><footer class="portfolio-page-footer"><span>BIM · Hạ tầng · Tự động hóa</span><strong>05 / 07</strong></footer></section>",
]
`;

exports[`GD3-10: markup outside the grid index is unchanged > project page project.editorial 1`] = `
[
  "<section class="portfolio-page portfolio-page--project portfolio-page--project-editorial" data-portfolio-layout="project.editorial"><header class="portfolio-page-header"><strong>HUYNH DUC LUONG</strong><span>Selected work</span></header><div class="portfolio-project portfolio-project--editorial"><section><div class="portfolio-project-heading"><p class="portfolio-kicker">01 / Ca Mau</p><h2>Duong giao thong ra dao Hon Khoai</h2><strong>BIM Coordinator</strong></div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="landscape"><span>Project image placeholder</span></div><figcaption>01 / Coordinated model overview</figcaption></figure></section><aside><p class="portfolio-project__summary">The project includes Viet Nam&#39;s longest sea-crossing bridge, extending over 18 km and representing an investment of more than VND 25.7 trillion. It connects the Dat Mui area to the Hon Khoai dual-use port in Ca Mau Province.</p><div class="portfolio-project-facts"><div><strong>8</strong><span>Tools</span></div></div><div class="portfolio-project__editorial-note"><p class="portfolio-kicker">Selected contribution</p><p>Led the BIM modeling team and coordinated multidisciplinary models.</p></div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="wide"><span>Project image placeholder</span></div><figcaption>02 / Supporting detail</figcaption></figure><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></aside></div><footer class="portfolio-page-footer"><span>BIM · Infrastructure · Automation</span><strong>04 / 07</strong></footer></section>",
  "<section class="portfolio-page portfolio-page--project portfolio-page--project-editorial" data-portfolio-layout="project.editorial"><header class="portfolio-page-header"><strong>HUYNH DUC LUONG</strong><span>Selected work</span></header><div class="portfolio-project portfolio-project--editorial"><section><div class="portfolio-project-heading"><p class="portfolio-kicker">02 / Ca Mau</p><h2>Cao toc Ca Mau - Cai Nuoc</h2><strong>BIM Coordinator</strong></div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="landscape"><span>Project image placeholder</span></div><figcaption>01 / Coordinated model overview</figcaption></figure></section><aside><p class="portfolio-project__summary">The 42-km Ca Mau-Cai Nuoc Expressway project includes 37 bridges and forms a key section of the expressway extending toward Dat Mui, improving regional connectivity and supporting economic development in the Mekong Delta.</p><div class="portfolio-project-facts"><div><strong>8</strong><span>Tools</span></div></div><div class="portfolio-project__editorial-note"><p class="portfolio-kicker">Selected contribution</p><p>Led the BIM modeling team and coordinated multidisciplinary models.</p></div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="wide"><span>Project image placeholder</span></div><figcaption>02 / Supporting detail</figcaption></figure><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></aside></div><footer class="portfolio-page-footer"><span>BIM · Infrastructure · Automation</span><strong>05 / 07</strong></footer></section>",
]
`;

