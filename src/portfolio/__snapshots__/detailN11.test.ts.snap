exports[`GD3-10: markup outside the grid index is unchanged > project page project.balanced 1`] = `
[
  "<section class="portfolio-page portfolio-page--project portfolio-page--project-balanced" data-portfolio-layout="project.balanced"><header class="portfolio-page-header"><strong>HUYNH DUC LUONG</strong><span>Selected work</span></header><div class="portfolio-project portfolio-project--balanced"><div class="portfolio-project-heading"><p class="portfolio-kicker">01 / Ca Mau</p><h2>Duong giao thong ra dao Hon Khoai</h2><strong>BIM Coordinator</strong></div><div class="portfolio-project__balanced-grid"><div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="wide"><span>Project image placeholder</span></div><figcaption>01 / Coordinated model overview</figcaption></figure><div class="portfolio-project-facts"><div><strong>8</strong><span>Tools</span></div><p>The project includes Viet Nam&#39;s longest sea-crossing bridge, extending over 18 km and representing an investment of more than VND 25.7 trillion. It connects the Dat Mui area to the Hon Khoai dual-use port in Ca Mau Province.</p></div></div><aside><p class="portfolio-kicker">My contribution</p><div class="portfolio-contributions"><article><span>01</span><p>Led the BIM modeling team and coordinated multidisciplinary models.</p></article><article><span>02</span><p>Reviewed model quality and resolved coordination and clash issues.</p></article><article><span>03</span><p>Managed BIM models and deliverables through Autodesk Construction Cloud.</p></article></div><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></aside></div></div><footer class="portfolio-page-footer"><span>BIM · Infrastructure · Automation</span><strong>04 / 07</strong></footer></section>",
  "<section class="portfolio-page portfolio-page--project portfolio-page--project-balanced" data-portfolio-layout="project.balanced"><header class="portfolio-page-header"><strong>HUYNH DUC LUONG</strong><span>Selected work</span></header><div class="portfolio-project portfolio-project--balanced"><div class="portfolio-project-heading"><p class="portfolio-kicker">02 / Ca Mau</p><h2>Cao toc Ca Mau - Cai Nuoc</h2><strong>BIM Coordinator</strong></div><div class="portfolio-project__balanced-grid"><div><figure><div class="portfolio-image-placeholder portfolio-project-image" data-crop-profile="wide"><span>Project image placeholder</span></div><figcaption>01 / Coordinated model overview</figcaption></figure><div class="portfolio-project-facts"><div><strong>8</strong><span>Tools</span></div><p>The 42-km Ca Mau-Cai Nuoc Expressway project includes 37 bridges and forms a key section of the expressway extending toward Dat Mui, improving regional connectivity and supporting economic development in the Mekong Delta.</p></div></div><aside><p class="portfolio-kicker">My contribution</p><div class="portfolio-contributions"><article><span>01</span><p>Led the BIM modeling team and coordinated multidisciplinary models.</p></article><article><span>02</span><p>Reviewed model quality and resolved coordination and clash issues.</p></article><article><span>03</span><p>Managed BIM models and deliverables through Autodesk Construction Cloud.</p></article></div><ul class="portfolio-tags"><li>Revit</li><li>Civil 3D</li><li>Navisworks</li><li>ACC</li><li>C#</li><li>WPF</li><li>Dynamo</li><li>Python</li></ul></aside></div></div><footer class="portfolio-page-footer"><span>BIM · Infrastructure · Automation</span><strong>05 / 07</strong></footer></section>",
]
`;

